{
  "expo": {
    "name": "SleepTracker",
    "slug": "SleepTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sleeptracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSHealthShareUsageDescription": "SleepTracker 需要读取您的心率数据，以提供更准确的睡眠分析和健康建议。",
        "NSHealthUpdateUsageDescription": "SleepTracker 需要访问健康数据，以便在未来的版本中支持更智能的健康功能。"
      },
      "bundleIdentifier": "com.anonymous.SleepTracker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "BODY_SENSORS",
        "ACTIVITY_RECOGNITION",
        "BODY_SENSORS",
        "ACTIVITY_RECOGNITION"
      ],
      "package": "com.anonymous.SleepTracker"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-localization",
      "expo-dev-client",
      "expo-font",
      "expo-web-browser",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "SleepTracker reads your heart-rate and sleep data to show your recent health summary.",
          "NSHealthUpdateUsageDescription": "SleepTracker can save sleep data only when you choose to add it."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
