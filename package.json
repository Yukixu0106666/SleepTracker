{
  "name": "sleeptracker",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "ios:dev-client": "expo run:ios",
    "android:dev-client": "expo run:android",
    "server:recommendations": "node server/index.mjs",
    "lint": "expo lint",
    "server:ingestion": "npm --prefix server start",
    "db:migrate": "npm --prefix server run migrate",
    "db:credential": "npm --prefix server run credential --",
    "test:ingestion": "npm --prefix server test",
    "test:sync": "node --experimental-strip-types --test tests/sleepJournal.test.mjs",
    "db:local": "bash scripts/local-postgres.sh start",
    "db:local:stop": "bash scripts/local-postgres.sh stop"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
